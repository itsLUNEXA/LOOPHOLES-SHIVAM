# ==============================================================================
# Hyperlocal Event Discovery - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   copy .env.example .env
# ==============================================================================

# Django Secret Key (generate a strong key for production)
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production

# Debug Mode: Set to True for development, False in production
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Timezone (Default for project is Asia/Kolkata as required)
TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string -> URI:
#
# Option A (Recommended for Django ORM & Migrations): Session Pooler (Port 5432)
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres
#
# Option B: Direct Connection (IPv6 or IPv4 Add-on, Port 5432)
# DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# Option C: Local Development / Testing Fallback
# If DATABASE_URL is left empty or unset, Django gracefully defaults to sqlite3:
DATABASE_URL=

# Media & Static Storage Note:
# In development, files are stored locally in the ./media directory.
# In production, configure persistent cloud storage (such as AWS S3 or Supabase Storage bucket).
